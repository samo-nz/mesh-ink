# ESP32-S3 cache configuration for the field-tested EPDiy LCD/DMA release target.
# This file is used by the Arduino+ESP-IDF t5-unified-cache64 environment.
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_ARDUINO_VARIANT="esp32s3"

# Match the board's normal Arduino qio_opi memory variant: 8 MB Octal PSRAM
# is initialized at boot and exposed through heap_caps/Arduino malloc.
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SIZE=-1
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=0
CONFIG_DEFAULT_PSRAM_CLK_IO=30
CONFIG_DEFAULT_PSRAM_CS_IO=26
CONFIG_ESP_SLEEP_PSRAM_LEAKAGE_WORKAROUND=y

# Keep release serial output focused on warnings/errors. MeshInk's own
# deliberate [T5-*] Serial messages are unaffected by the ESP-IDF log level.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
# CONFIG_BOOTLOADER_LOG_LEVEL_INFO is not set
CONFIG_BOOTLOADER_LOG_LEVEL=2
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set
CONFIG_LOG_DEFAULT_LEVEL=2
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_LOG_MAXIMUM_LEVEL=2

# Keep serial output plain text. ESP-IDF otherwise wraps log lines in ANSI
# colour escapes that show up as visible garbage in simple serial monitors.
# CONFIG_LOG_COLORS is not set
# CONFIG_ARDUHAL_LOG_COLORS is not set

# Match the normal Arduino ESP32-S3 Bluetooth/BLE capabilities used by
# MeshCore's SerialBLEInterface.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=y

# Arduino 2.0.x / ESP-IDF 4.4 also emits legacy compatibility aliases.
# Some Bluedroid source gates still key off these names.
CONFIG_BLUEDROID_ENABLED=y
CONFIG_BLUEDROID_PINNED_TO_CORE_0=y
CONFIG_BLUEDROID_PINNED_TO_CORE=0
CONFIG_GATTS_ENABLE=y
CONFIG_GATTS_SEND_SERVICE_CHANGE_AUTO=y
CONFIG_GATTS_SEND_SERVICE_CHANGE_MODE=0
CONFIG_GATTC_ENABLE=y

# The actual experiment: allow EPDiy's LCD/DMA path to keep its configured
# 20 MHz pixel clock instead of automatically reducing it to 10 MHz.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# CONFIG_ESP32S3_DATA_CACHE_LINE_32B is not set
CONFIG_ESP32S3_DATA_CACHE_LINE_SIZE=64


# PMTiles cold-load A/B: the archive is one large read-only FAT file with
# repeated long/random seeks. ESP-IDF fast-seek builds a CLMT so lseek can
# avoid walking the FAT chain for each tile range. Keep FAT buffer placement
# unchanged in this build so the speed difference is attributable to fast-seek.
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_FAST_SEEK_BUFFER_SIZE=1024
